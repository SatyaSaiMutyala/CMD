# Port the API and the socket listen on (5000 is taken by AirPlay on macOS)
PORT=5050

# "production" on the server; leave unset on your own machine
NODE_ENV=

# MongoDB Atlas connection string. Keep the database name (cmd_hub) before the "?".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cmd_hub?retryWrites=true&w=majority

# Signs the login tokens. Use a long random value and keep it secret.
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d

# Browser origins allowed to call the API, comma separated. Empty = any (development only).
CORS_ORIGINS=http://localhost:5173

# Minutes between pending-approval reminders
REMINDER_MINUTES=15

# ---- The two keys shared with every connected project ----
# One pair for all of them, so connecting a project needs only its address
# here (LEDGERTRACE_API_URL, EDOS_API_URL, ...) and these same two values in
# that project's own .env. Use a long random value for each; never the same
# value for both.
#
# HUB_API_KEY      we send it, as X-Api-Key, when we read or decide in a
#                  project. In each project's .env it is CMD_HUB_API_KEY.
# HUB_WEBHOOK_KEY  a project sends it, as X-Api-Key, when it tells us
#                  something arrived. In each project's .env it is
#                  CMD_HUB_WEBHOOK_KEY.
#
# Anyone holding HUB_API_KEY can approve in EVERY connected project, so a leak
# from one project's server exposes them all. To change the keys, change them
# here and in every project at the same time.
HUB_API_KEY=
HUB_WEBHOOK_KEY=

# ---- Optional: a key of its own for one project ----
# Leave these empty to use the shared pair above. Set one and that project
# uses it instead (for example to cut one project off without touching the
# others). HOOK_KEY_<ID> is that project's webhook key.
HOOK_KEY_LEDGERTRACE=
HOOK_KEY_EDOS=
HOOK_KEY_AIMS=
HOOK_KEY_SP365=
HOOK_KEY_PACE=
HOOK_KEY_TAMS=
HOOK_KEY_TRUFLOW=

# This server's own public address, e.g. https://hub.example.com (no trailing
# slash). Used to build the links that open attached documents. Leave empty
# on your own machine: the address of each request is used instead.
PUBLIC_URL=

# LedgerTrace: where its /api/cmdhub/* endpoints live, and the key it expects
# from us (CMD_HUB_API_KEY in LedgerTrace's .env). Empty = LedgerTrace is off.
# The other direction uses HOOK_KEY_LEDGERTRACE above, which must equal
# CMD_HUB_WEBHOOK_KEY in LedgerTrace's .env.
LEDGERTRACE_API_URL=http://127.0.0.1:8010
LEDGERTRACE_API_KEY=
# How long to wait for LedgerTrace before giving up, in milliseconds
LEDGERTRACE_TIMEOUT_MS=15000
# eDOS: where its /api/cmdhub/* endpoints live, and the key it expects from us
# (CMD_HUB_API_KEY in eDOS's .env). Empty = eDOS is off. The other direction
# uses HOOK_KEY_EDOS above, which must equal CMD_HUB_WEBHOOK_KEY in eDOS's .env.
EDOS_API_URL=
EDOS_API_KEY=
# How long to wait for eDOS before giving up, in milliseconds
EDOS_TIMEOUT_MS=15000

# AIMS: where its /api/cmdhub/* endpoints live, and the key it expects from us
# (CMD_HUB_API_KEY in AIMS's .env). Empty = AIMS is off. The other direction
# uses HOOK_KEY_AIMS above, which must equal CMD_HUB_WEBHOOK_KEY in AIMS's
# .env. The hub sees AIMS's approval queues in full, as an administrator does.
AIMS_API_URL=
AIMS_API_KEY=
# How long to wait for AIMS before giving up, in milliseconds
AIMS_TIMEOUT_MS=15000

# Sales Pulse 365: where its /api/cmdhub/* endpoints live, and the key it
# expects from us (CMD_HUB_API_KEY in Sales Pulse's .env). Empty = Sales Pulse
# is off. The other direction uses HOOK_KEY_SP365 above, which must equal
# CMD_HUB_WEBHOOK_KEY in Sales Pulse's .env.
SP365_API_URL=
SP365_API_KEY=
# How long to wait for Sales Pulse before giving up, in milliseconds
SP365_TIMEOUT_MS=15000

# Phone push (Android, iPhone): path to the Firebase service-account JSON. Empty = off.
# Get the file from Firebase console > Project settings > Service accounts >
# Generate new private key, and save it in this folder (it is git-ignored).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Browser push: generate once with  npx web-push generate-vapid-keys   Empty = off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
